{
  "name": "mortise",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "scripts"
  ],
  "scripts": {
    "dev": "bun run --filter @mortise/desktop dev",
    "build": "bun run --filter @mortise/desktop build",
    "typecheck": "bun run --filter '@mortise/*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:deps": "depcruise packages apps scripts --config .dependency-cruiser.cjs",
    "check": "bun run lint && bun run typecheck && bun run check:deps && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.5.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
